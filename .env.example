# Airwallex sandbox credentials: sandbox.airwallex.com → Account → Developer → API keys.
# Copy to .env (never commit it).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Optional
AIRWALLEX_CREATED_BY=Your Full Legal Name
AIRWALLEX_BASE=https://api.sandbox.airwallex.com
# Optional: the agent explains each decision in its own words (Claude, over the Messages API). Without a
# key the consoles use their own wording; the decision itself is code either way.
ANTHROPIC_API_KEY=
# OUTBID_MODEL=claude-opus-5-5
# Metal testnet (fee escrow): console-testnet.metalntwx.com → Endpoints → New endpoint (testnet).
METAL_RPC_URL=https://rpc-testnet.metalntwx.com/v1/your-endpoint-id
# A disposable test key (cast wallet new), funded with USDZ at faucet.metalntwx.com.
METAL_PRIVATE_KEY=
